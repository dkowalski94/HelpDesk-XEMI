---
import PageShell from "@/layouts/PageShell.astro";
import AccountStatusNotice from "@/components/AccountStatusNotice.astro";
import { isClientUser } from "@/lib/services/profile";
import { HEADING_CLASS, LEAD_CLASS } from "@/lib/ui-classes";
import { cn } from "@/lib/utils";

/**
 * Audience branches of a client-only page (`/report-error`, `/my-tickets`) inside `PageShell`,
 * with the profile-error / staff / waiting messages in one place so both pages show identical
 * texts (profile-error and waiting come from the shared `AccountStatusNotice`, also used by the
 * start page). The tab title is the `h1` of the branch rendered. The default slot is rendered
 * only for the one audience the client endpoints accept (client users of a client company). A
 * missing profile reads as "waiting for assignment", as on the start page.
 */
interface Props {
  /** The client branch's `h1`, also the tab title. */
  heading: string;
  /** Optional hint under the client heading. */
  intro?: string;
}

const { heading, intro } = Astro.props;
const { profile, profileLookupFailed } = Astro.locals;

const isStaff = profile?.role === "service_staff";
const isClient = isClientUser(profile);

const STAFF_HEADING = "Strona dla klientów";
// The `h1` texts of AccountStatusNotice's two statuses — keep in sync with that component.
const PROFILE_ERROR_HEADING = "Nie udało się wczytać Twojego konta";
const WAITING_HEADING = "Konto czeka na przypisanie";

const title = profileLookupFailed
  ? PROFILE_ERROR_HEADING
  : isStaff
    ? STAFF_HEADING
    : isClient
      ? heading
      : WAITING_HEADING;

// The staff message is the card's last paragraph: no lead margin under it.
const staffLeadClass = cn(LEAD_CLASS, "mb-0");
---

<PageShell title={title}>
  {profileLookupFailed ? (
    <AccountStatusNotice status="profile-error" headingLevel="h1" />
  ) : isStaff ? (
    <>
      <h1 class:list={HEADING_CLASS}>{STAFF_HEADING}</h1>
      <p class:list={staffLeadClass}>
        Ta strona jest przeznaczona dla użytkowników klienta. Konto serwisowe nie zgłasza błędów i nie ma własnych
        zgłoszeń.
      </p>
    </>
  ) : isClient ? (
    <>
      <h1 class:list={HEADING_CLASS}>{heading}</h1>
      {intro && <p class:list={LEAD_CLASS}>{intro}</p>}
      <slot />
    </>
  ) : (
    <AccountStatusNotice status="waiting" headingLevel="h1" />
  )}
</PageShell>
