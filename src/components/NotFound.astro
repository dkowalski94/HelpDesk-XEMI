---
import { buttonVariants } from "@/components/ui/button";
import { HEADING_CLASS, LEAD_CLASS } from "@/lib/ui-classes";

/**
 * The "page not found" content of `404.astro`. Reads no locals, so the kitchen sink renders the
 * same markup; the route adds `PageShell` (frame, user bar and the panel card).
 */

// `buttonVariants()` already draws the full-strength focus ring.
const backLinkClass = buttonVariants({ variant: "default" });
---

<h1 class:list={HEADING_CLASS}>Nie znaleziono strony</h1>
<p class:list={LEAD_CLASS}>Ta strona nie istnieje albo została przeniesiona.</p>
<div>
  <a href="/" class:list={backLinkClass}>
    Wróć na stronę startową
  </a>
</div>
