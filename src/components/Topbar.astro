---
// Token classes only: light on /report-error, dark (cosmic `.dark` values) on pages that wrap it in class="dark".
const { user } = Astro.locals;

const linkClass =
  "rounded-sm text-primary transition-colors hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-border bg-muted px-4 py-2 text-sm text-muted-foreground">
  {user ? (
    <>
      <span class="text-muted-foreground">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class:list={linkClass}>
          Dashboard
        </a>
        <a href="/search" class:list={linkClass}>
          Web search
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={linkClass}>
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class:list={linkClass}>
          Sign in
        </a>
        <a href="/auth/signup" class:list={linkClass}>
          Sign up
        </a>
      </div>
    </>
  )}
</div>
