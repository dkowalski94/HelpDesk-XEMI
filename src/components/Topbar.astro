---
import UserBar from "@/components/UserBar.astro";
import { isClientUser } from "@/lib/services/profile";

// Resolves the signed-in user and their role entries for the presentational UserBar.
const { user, profile, profileLookupFailed } = Astro.locals;

const access =
  profileLookupFailed || !profile
    ? "none"
    : profile.role === "service_staff"
      ? "staff"
      : isClientUser(profile)
        ? "client"
        : "none";
---

<UserBar email={user?.email ?? null} access={access} currentPath={Astro.url.pathname} />
