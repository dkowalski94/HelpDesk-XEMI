---
import { CircleCheck, MailCheck } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { confirmEmailContent } from "@/components/auth/confirm-email";
import { HEADING_CLASS, LEAD_CLASS } from "@/lib/ui-classes";

/**
 * The content of `/auth/confirm-email`, centred inside the narrow card. Reads no locals or env,
 * so the kitchen sink renders both variants with static props; the route decides
 * `autoConfirmed` and adds `PageShell` (frame, user bar and the narrow card).
 */
export interface Props {
  /** Local dev auto-confirms new accounts: the user can sign in right away. */
  autoConfirmed: boolean;
}

const { autoConfirmed } = Astro.props;

const content = confirmEmailContent(autoConfirmed);
const Icon = autoConfirmed ? CircleCheck : MailCheck;

// The next step as a primary button, like the 404's; `buttonVariants()` already draws the focus ring.
const signinLinkClass = buttonVariants({ variant: "default" });
---

<div class="flex flex-col items-center text-center">
  <Icon className="mb-4 size-12 text-primary" aria-hidden="true" />
  <h1 class:list={HEADING_CLASS}>{content.heading}</h1>
  <p class:list={LEAD_CLASS}>{content.description}</p>
  <a href="/auth/signin" class:list={signinLinkClass}>
    Przejdź do logowania
  </a>
</div>
