---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Textarea } from "@/components/ui/textarea";
import { ErrorAlert } from "@/components/error-resolution/ErrorAlert";
import { FIXED_ROWS, FOCUS_RING, INNER_CARD } from "@/components/error-resolution/format";
import { RESOLUTION_TEXT_MAX_LENGTH } from "@/lib/services/ticket-resolution";
import { cn } from "@/lib/utils";
import type { StaffQueueResult } from "@/types";

/**
 * The staff queue on `/admin/tickets`: every client company's open tickets with a resolve form each.
 * Reads no locals and runs no query, so the kitchen sink can render every state with static props;
 * the route maps the query string to the messages and loads the queue.
 *
 * The smoke test reads `name="ticketId" value="<id>"` from the HTML, and the preview script below
 * finds each form by `data-company-name` and its native `cause`/`steps` textareas.
 */
interface Props {
  queue: StaffQueueResult;
  /** Fixed success text chosen by the route from `status`, or `null`. */
  successMessage: string | null;
  /** Fixed error text chosen by the route from `error`, or `null`. */
  errorMessage: string | null;
  /** Knowledge base entries without an embedding; `null` when unknown. */
  missingEmbeddings: number | null;
  /** Link to the next page of the queue, shown as "Dalej". */
  nextHref: string | null;
}

const { queue, successMessage, errorMessage, missingEmbeddings, nextHref } = Astro.props;

const RESOLUTION_PREVIEW_HINT =
  "Dane firmy, nazwiska i numery zostaną zamaskowane. Zgłaszający zobaczy przyczynę i kroki bez zmian.";

function formatDate(iso: string) {
  return new Date(iso).toLocaleString("pl-PL", { dateStyle: "medium", timeStyle: "short" });
}

const headingClass = "mb-2 text-2xl font-bold text-foreground";
const hint = "mb-6 text-sm text-muted-foreground";
const labelClass = "block text-xs font-semibold text-foreground";
const bodyTextClass = "text-sm break-words whitespace-pre-line text-foreground/80";
const previewBoxClass = "rounded-lg border border-border bg-card p-3";
const previewTextClass = "mt-1 text-sm break-words whitespace-pre-line text-muted-foreground";
const textareaClass = cn("mt-1 bg-card", FIXED_ROWS, FOCUS_RING);
---

<h1 class:list={headingClass}>Zgłoszenia do rozwiązania</h1>
<p class:list={hint}>
  Otwarte zgłoszenia wszystkich firm klienckich, od najstarszych. Zapisane rozwiązanie trafia do zgłaszającego i do bazy
  wiedzy.
</p>

{successMessage && (
  <Alert className="mb-4 border-success/40 bg-success/10">
    <AlertDescription className="font-semibold text-success">{successMessage}</AlertDescription>
  </Alert>
)}
{errorMessage && (
  <div class="mb-4">
    <ErrorAlert message={errorMessage} />
  </div>
)}

{missingEmbeddings !== null && missingEmbeddings > 0 && (
  <form
    method="POST"
    action="/api/admin/backfill-embeddings"
    class="mb-6 flex flex-col gap-3 rounded-lg border border-warning/40 bg-warning/10 p-4 sm:flex-row sm:items-center"
  >
    <p class="flex-1 text-sm font-semibold text-warning">{missingEmbeddings} rozwiązań czeka na embedding</p>
    <Button type="submit" variant="outline" className={FOCUS_RING}>
      Przelicz
    </Button>
  </form>
)}

{queue.status === "error" ? (
  <ErrorAlert message="Nie udało się wczytać zgłoszeń. Odśwież stronę za chwilę." />
) : queue.tickets.length === 0 ? (
  <p class="text-sm text-muted-foreground">Brak zgłoszeń do rozwiązania.</p>
) : (
  <ul class="space-y-4">
    {queue.tickets.map((ticket) => (
      <li>
        <Card className={INNER_CARD}>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
            <p class="font-semibold text-foreground">{ticket.companyName ?? "Nieznana firma"}</p>
            <p class="text-xs text-muted-foreground">{formatDate(ticket.createdAt)}</p>
          </div>
          <p class:list={cn("mt-2", bodyTextClass)}>{ticket.errorText}</p>
          {ticket.userComment && (
            <div class="mt-3">
              <p class:list={labelClass}>Komentarz klienta</p>
              <p class:list={cn("mt-1", bodyTextClass)}>{ticket.userComment}</p>
            </div>
          )}
          <div class:list={cn("mt-3", previewBoxClass)}>
            <p class:list={labelClass}>Do bazy wiedzy trafi:</p>
            <p class:list={previewTextClass}>{ticket.kbPreview}</p>
          </div>
          <form
            method="POST"
            action="/api/admin/resolve-ticket"
            class="mt-4 space-y-3"
            data-company-name={ticket.companyName ?? ""}
          >
            <input type="hidden" name="ticketId" value={ticket.id} />
            <div>
              <label for={`cause-${ticket.id}`} class:list={labelClass}>
                Przyczyna (opcjonalnie)
              </label>
              <Textarea
                id={`cause-${ticket.id}`}
                name="cause"
                rows={2}
                maxLength={RESOLUTION_TEXT_MAX_LENGTH}
                className={textareaClass}
              />
            </div>
            <div>
              <label for={`steps-${ticket.id}`} class:list={labelClass}>
                Kroki
              </label>
              <Textarea
                id={`steps-${ticket.id}`}
                name="steps"
                rows={4}
                required
                maxLength={RESOLUTION_TEXT_MAX_LENGTH}
                className={textareaClass}
              />
            </div>
            <div class:list={previewBoxClass}>
              <p class:list={labelClass}>Inne firmy zobaczą przyczynę i kroki tak:</p>
              <p class:list={previewTextClass} data-kb-resolution-preview>
                {RESOLUTION_PREVIEW_HINT}
              </p>
            </div>
            <Button type="submit" className={FOCUS_RING}>
              Zapisz rozwiązanie
            </Button>
          </form>
        </Card>
      </li>
    ))}
  </ul>
)}

{nextHref !== null && (
  <a href={nextHref} class:list={cn("mt-6 self-start", buttonVariants({ variant: "outline" }), FOCUS_RING)}>
    Dalej
  </a>
)}

<script>
  import { sanitizeResolutionText } from "@/lib/sanitize-error-text";

  // Same function the server applies to the knowledge base copy, so the preview is what other
  // companies will read. Without JavaScript the server-rendered hint stays in place.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-company-name]")) {
    const preview = form.querySelector<HTMLElement>("[data-kb-resolution-preview]");
    const cause = form.elements.namedItem("cause");
    const steps = form.elements.namedItem("steps");
    if (!preview || !(cause instanceof HTMLTextAreaElement) || !(steps instanceof HTMLTextAreaElement)) continue;

    const hint = (preview.textContent ?? "").trim();
    const companyName = form.dataset.companyName || null;
    form.addEventListener("input", () => {
      const maskedCause = sanitizeResolutionText(cause.value, companyName);
      const maskedSteps = sanitizeResolutionText(steps.value, companyName);
      const parts = [maskedCause && `Przyczyna: ${maskedCause}`, maskedSteps && `Kroki:\n${maskedSteps}`];
      preview.textContent = parts.filter(Boolean).join("\n\n") || hint;
    });
  }
</script>
