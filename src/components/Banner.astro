---
type Variant = "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "error" } = Astro.props;

// Token classes only (UI contract roles). Links inside the slot get the full-strength outline focus.
const variantClass: Record<Variant, string> = {
  error: "border-b border-destructive/40 bg-destructive/10 text-destructive",
  warning: "border-b border-warning/40 bg-warning/10 text-warning",
};
const linkClass =
  "[&_a]:rounded-sm [&_a]:font-semibold [&_a]:underline [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-offset-2 [&_a]:focus-visible:outline-ring";
---

<div
  class:list={["px-4 py-3 text-center text-sm", variantClass[variant], linkClass]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
