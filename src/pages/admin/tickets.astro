---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { countMissingEmbeddings, listTodoQueue, RESOLUTION_TEXT_MAX_LENGTH } from "@/lib/services/ticket-resolution";
import type { StaffQueueResult } from "@/types";

// Messages are fixed strings keyed by a code so the query string can never put
// arbitrary text on the page. Only the digits-only `filled` count is echoed.
const STATUS_MESSAGES: Record<string, string> = {
  resolved: "Rozwiązanie zapisane i dodane do bazy wiedzy.",
  "resolved-no-embedding":
    "Rozwiązanie zapisane, ale embedding nie został policzony — wpis nie będzie dopasowywany, dopóki nie użyjesz „Przelicz”.",
};

const ERROR_MESSAGES: Record<string, string> = {
  "missing-fields": "Uzupełnij kroki rozwiązania przed zapisaniem.",
  "not-configured": "Supabase nie jest skonfigurowany.",
  invalid: "Rozwiązanie jest puste albo za długie. Popraw je i spróbuj ponownie.",
  "not-found": "To zgłoszenie już nie istnieje.",
  "already-resolved": "To zgłoszenie zostało już rozwiązane.",
  unavailable: "Nie udało się policzyć embeddingów — usługa OpenAI jest niedostępna lub nieskonfigurowana.",
  error: "Operacja się nie powiodła. Spróbuj ponownie.",
};

const status = Astro.url.searchParams.get("status");
const errorCode = Astro.url.searchParams.get("error");
const filled = Astro.url.searchParams.get("filled");
const successMessage =
  status === "backfilled" && filled !== null && /^\d+$/.test(filled)
    ? `Uzupełniono embeddingi: ${filled}.`
    : status === null
      ? null
      : (STATUS_MESSAGES[status] ?? null);
const errorMessage = errorCode === null ? null : (ERROR_MESSAGES[errorCode] ?? null);

const offsetParam = Astro.url.searchParams.get("offset");
const offset = offsetParam !== null && /^\d+$/.test(offsetParam) ? Number(offsetParam) : 0;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const queue: StaffQueueResult = supabase ? await listTodoQueue(supabase, { offset }) : { status: "error" };
const missingEmbeddings = supabase ? await countMissingEmbeddings(supabase) : null;

function formatDate(iso: string) {
  return new Date(iso).toLocaleString("pl-PL", { dateStyle: "medium", timeStyle: "short" });
}
---

<Layout title="Zgłoszenia do rozwiązania">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-3xl">
      <Topbar />
      <div lang="pl" class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Zgłoszenia do rozwiązania
        </h1>
        <p class="mb-6 text-sm text-blue-100/60">
          Otwarte zgłoszenia wszystkich firm klienckich, od najstarszych. Zapisane rozwiązanie trafia do zgłaszającego i
          do bazy wiedzy.
        </p>

        {successMessage && <p class="mb-4 text-sm font-semibold text-emerald-200">{successMessage}</p>}
        {errorMessage && <p class="mb-4 text-sm font-semibold text-rose-200">{errorMessage}</p>}

        {missingEmbeddings !== null && missingEmbeddings > 0 && (
          <form
            method="POST"
            action="/api/admin/backfill-embeddings"
            class="mb-6 flex flex-col gap-3 rounded-lg border border-amber-200/30 bg-amber-200/10 p-4 sm:flex-row sm:items-center"
          >
            <p class="flex-1 text-sm text-amber-100">{missingEmbeddings} rozwiązań czeka na embedding</p>
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Przelicz
            </button>
          </form>
        )}

        {queue.status === "error" ? (
          <p class="text-rose-200">Nie udało się wczytać zgłoszeń. Odśwież stronę za chwilę.</p>
        ) : queue.tickets.length === 0 ? (
          <p class="text-blue-100/80">Brak zgłoszeń do rozwiązania.</p>
        ) : (
          <ul class="space-y-4">
            {queue.tickets.map((ticket) => (
              <li class="rounded-xl border border-white/10 bg-white/5 p-4">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
                  <p class="font-semibold">{ticket.companyName ?? "Nieznana firma"}</p>
                  <p class="text-xs text-blue-100/50">{formatDate(ticket.createdAt)}</p>
                </div>
                <p class="mt-2 text-sm break-words whitespace-pre-line text-blue-100/80">{ticket.errorText}</p>
                {ticket.userComment && (
                  <div class="mt-3">
                    <p class="text-xs font-semibold text-white">Komentarz klienta</p>
                    <p class="mt-1 text-sm break-words whitespace-pre-line text-blue-100/80">{ticket.userComment}</p>
                  </div>
                )}
                <div class="mt-3 rounded-lg border border-white/10 bg-black/10 p-3">
                  <p class="text-xs font-semibold text-white">Do bazy wiedzy trafi:</p>
                  <p class="mt-1 text-sm break-words whitespace-pre-line text-blue-100/60">{ticket.kbPreview}</p>
                </div>
                <form method="POST" action="/api/admin/resolve-ticket" class="mt-4 space-y-3">
                  <input type="hidden" name="ticketId" value={ticket.id} />
                  <div>
                    <label for={`cause-${ticket.id}`} class="block text-xs font-semibold text-white">
                      Przyczyna (opcjonalnie)
                    </label>
                    <textarea
                      id={`cause-${ticket.id}`}
                      name="cause"
                      rows="2"
                      maxlength={RESOLUTION_TEXT_MAX_LENGTH}
                      class="mt-1 w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-blue-100/40 focus:border-purple-300/60 focus:outline-none"
                    ></textarea>
                  </div>
                  <div>
                    <label for={`steps-${ticket.id}`} class="block text-xs font-semibold text-white">
                      Kroki
                    </label>
                    <textarea
                      id={`steps-${ticket.id}`}
                      name="steps"
                      rows="4"
                      required
                      maxlength={RESOLUTION_TEXT_MAX_LENGTH}
                      class="mt-1 w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-blue-100/40 focus:border-purple-300/60 focus:outline-none"
                    ></textarea>
                  </div>
                  <button
                    type="submit"
                    class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
                  >
                    Zapisz rozwiązanie
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}

        {queue.status === "ok" && queue.nextOffset !== null && (
          <a
            href={`/admin/tickets?offset=${String(queue.nextOffset)}`}
            class="mt-6 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            Dalej
          </a>
        )}
      </div>
    </div>
  </div>
</Layout>
