---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import StaffUserAssignment from "@/components/admin/StaffUserAssignment.astro";
import { Card } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { listPendingAssignments } from "@/lib/services/company-assignment";
import type { PendingAssignmentsResult } from "@/types";

// Messages are fixed strings keyed by a code so the query string can never put
// arbitrary text on the page.
const ERROR_MESSAGES: Record<string, string> = {
  "missing-fields": "Wybierz firmę przed przypisaniem.",
  "not-configured": "Supabase nie jest skonfigurowany.",
  "invalid-company": "Do tej firmy nie można przypisać kont. Wybierz firmę kliencką.",
  "not-updated": "Nic nie zmieniono — konto już nie istnieje albo ma już firmę.",
  error: "Przypisanie się nie powiodło. Spróbuj ponownie.",
};

const status = Astro.url.searchParams.get("status");
const errorCode = Astro.url.searchParams.get("error");
const successMessage = status === "assigned" ? "Konto przypisane do firmy." : null;
const errorMessage = errorCode === null ? null : (ERROR_MESSAGES[errorCode] ?? ERROR_MESSAGES.error);

const supabase = createClient(Astro.request.headers, Astro.cookies);
const pending: PendingAssignmentsResult = supabase ? await listPendingAssignments(supabase) : { status: "error" };
---

<Layout title="Konta do przypisania">
  <div class="min-h-screen bg-background p-4">
    <div class="mx-auto w-full max-w-5xl">
      <Topbar />
      <Card className="gap-0 p-6 sm:p-8">
        <StaffUserAssignment pending={pending} successMessage={successMessage} errorMessage={errorMessage} />
      </Card>
    </div>
  </div>
</Layout>
