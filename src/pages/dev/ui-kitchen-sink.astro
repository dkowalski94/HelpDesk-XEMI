---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import KitchenSink from "@/components/error-resolution/KitchenSink";

// Dev-only visual gate for the /report-error UI contract: an empty 404 in production builds and the preview.
// (A frontmatter `return new Response(...)` crashes @typescript-eslint/no-misused-promises in .astro files.)
const isDev = import.meta.env.DEV;
if (!isDev) Astro.response.status = 404;
---

{isDev && (
  <Layout title="Kitchen sink UI">
    <div lang="pl" class="min-h-screen space-y-10 bg-background p-4 sm:p-8">
      <header class="space-y-2">
        <h1 class="text-2xl font-bold text-foreground">Kitchen sink — Zgłoś błąd ERP</h1>
        <p class="text-sm text-muted-foreground">
          Każdy stan widoku /report-error na statycznych danych, bez zapytań do API. Hover i focus-visible sprawdź myszą
          i klawiszem Tab na tej stronie.
        </p>
      </header>

      <section class="space-y-4">
        <h2 class="text-xl font-bold text-foreground">Topbar</h2>
        <p class="text-sm text-muted-foreground">Motyw jasny (XEMI) i wariant ciemny w opakowaniu class="dark".</p>
        <Topbar />
        <div class="dark rounded-xl bg-background p-4">
          <Topbar />
        </div>
      </section>

      <KitchenSink client:only="react" />
    </div>
  </Layout>
)}
