---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ConfirmEmailNotice from "@/components/auth/ConfirmEmailNotice.astro";
import { confirmEmailContent } from "@/components/auth/confirm-email";

// Local dev auto-confirms new accounts; production sends an activation link.
const isAutoConfirmed = import.meta.env.DEV;
const { heading } = confirmEmailContent(isAutoConfirmed);
---

<Layout title={heading}>
  <div class="min-h-screen bg-background p-4">
    <div class="mx-auto w-full max-w-5xl">
      <Topbar />
      <ConfirmEmailNotice autoConfirmed={isAutoConfirmed} />
    </div>
  </div>
</Layout>
