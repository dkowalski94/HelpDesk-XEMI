---
import ClientPageLayout from "@/layouts/ClientPageLayout.astro";
import ErrorResolutionPanel from "@/components/error-resolution/ErrorResolutionPanel";

// The four audience branches are decided by the layout on the server: the island is
// mounted only for the one audience POST /api/resolve-error accepts.
---

<ClientPageLayout
  title="Zgłoś błąd ERP"
  heading="Zgłoś błąd z systemu ERP"
  intro="Wklej komunikat błędu. Najpierw poszukamy rozwiązania w bazie wiedzy i dokumentacji, a jeśli go nie znajdziemy, przekażemy zgłoszenie do zespołu serwisowego XEMI."
>
  <ErrorResolutionPanel client:load />
</ClientPageLayout>
