---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import WebSearchPanel from "@/components/search/WebSearchPanel";
---

<Layout title="Web search">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-3xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Web search
        </h1>
        <p class="mb-6 text-sm text-blue-100/60">
          Semantic web search powered by Exa. Each result includes the passages most relevant to your query.
        </p>
        <WebSearchPanel client:load />
      </div>
    </div>
  </div>
</Layout>
