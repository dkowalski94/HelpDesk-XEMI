---
import Layout from "@/layouts/Layout.astro";
import UserBar from "@/components/UserBar.astro";
import KitchenSink from "@/components/error-resolution/KitchenSink";
import StartPage from "@/components/start/StartPage.astro";
import NotFound from "@/components/NotFound.astro";
import StaffTicketQueue from "@/components/admin/StaffTicketQueue.astro";
import StaffUserAssignment from "@/components/admin/StaffUserAssignment.astro";
import AuthKitchenSink from "@/components/auth/AuthKitchenSink";
import ConfirmEmailNotice from "@/components/auth/ConfirmEmailNotice.astro";
import { Card } from "@/components/ui/card";
import type {
  PendingAssignmentsResult,
  PendingAssignmentUser,
  StaffCompanyOption,
  StaffQueueResult,
  StaffQueueTicket,
} from "@/types";

// Dev-only visual gate for the views on the UI contract (/, /report-error, /my-tickets, /admin/tickets, /admin/users, 404, /auth/*). Routed by the `devOnlyRoutes`
// integration in astro.config.mjs under `astro dev` only, so production builds do not contain it.

// Staff queue fixtures. Ids carry a per-cell prefix so the textarea ids stay unique on this page.
function queueTickets(prefix: string): StaffQueueTicket[] {
  return [
    {
      id: `${prefix}-1`,
      companyId: "company-alfa",
      status: "todo",
      errorText: "Błąd 4012: nie można zaksięgować dokumentu FV/2026/10/118 — okres zamknięty.",
      createdAt: "2026-10-20T08:15:00.000Z",
      resolution: null,
      resolutionCause: null,
      resolvedAt: null,
      companyName: "Klient Alfa",
      userComment: "Podpowiedź o otwarciu okresu nie pomogła — okres jest otwarty w ustawieniach.",
      kbPreview: "Błąd 4012: nie można zaksięgować dokumentu [NUMER] — okres zamknięty.",
    },
    {
      id: `${prefix}-2`,
      companyId: "company-beta",
      status: "todo",
      errorText: "Timeout połączenia z serwerem licencji po 30 s.",
      createdAt: "2026-10-22T13:40:00.000Z",
      resolution: null,
      resolutionCause: null,
      resolvedAt: null,
      companyName: "Klient Beta",
      userComment: null,
      kbPreview: "Timeout połączenia z serwerem licencji po 30 s.",
    },
  ];
}

const queueList = (prefix: string): StaffQueueResult => ({
  status: "ok",
  tickets: queueTickets(prefix),
  nextOffset: null,
});
const queueEmpty: StaffQueueResult = { status: "ok", tickets: [], nextOffset: null };
const queueError: StaffQueueResult = { status: "error" };
const companyOptions: StaffCompanyOption[] = [
  { id: "company-alfa", name: "Klient Alfa", openCount: 1 },
  { id: "company-beta", name: "Klient Beta", openCount: 1 },
  { id: "company-gamma", name: "Klient Gamma", openCount: 0 },
];
const queueAlfa = (prefix: string): StaffQueueResult => ({
  status: "ok",
  tickets: queueTickets(prefix).filter((ticket) => ticket.companyId === "company-alfa"),
  nextOffset: null,
});
const queueCells: {
  title: string;
  queue: StaffQueueResult;
  successMessage?: string;
  errorMessage?: string;
  missingEmbeddings?: number;
  nextHref?: string;
  companies?: StaffCompanyOption[] | null;
  selectedCompanyId?: string;
}[] = [
  { title: "Lista: dwa zgłoszenia (z komentarzem klienta i bez)", queue: queueList("ks-list") },
  { title: "Pusta kolejka", queue: queueEmpty },
  { title: "Błąd wczytania", queue: queueError },
  { title: "Komunikat sukcesu", queue: queueEmpty, successMessage: "Rozwiązanie zapisane i dodane do bazy wiedzy." },
  { title: "Komunikat po „Przelicz” (backfilled)", queue: queueEmpty, successMessage: "Uzupełniono embeddingi: 3." },
  { title: "Komunikat błędu", queue: queueEmpty, errorMessage: "To zgłoszenie zostało już rozwiązane." },
  { title: "Baner „Przelicz”", queue: queueEmpty, missingEmbeddings: 4 },
  { title: "Link „Dalej”", queue: queueList("ks-next"), nextHref: "/admin/tickets?offset=20" },
  {
    title: "Filtr: „Wszystkie firmy” (liczniki, w tym 0)",
    queue: queueList("ks-filter-all"),
    companies: companyOptions,
  },
  {
    title: "Filtr: wybrana firma i jej zgłoszenia (z banerem „Przelicz”)",
    queue: queueAlfa("ks-filter-alfa"),
    companies: companyOptions,
    selectedCompanyId: "company-alfa",
    missingEmbeddings: 2,
  },
  {
    title: "Filtr: brak zgłoszeń w wybranej firmie",
    queue: queueEmpty,
    companies: companyOptions,
    selectedCompanyId: "company-gamma",
  },
  {
    title: "Filtr ukryty (lista firm się nie wczytała)",
    queue: queueList("ks-filter-hidden"),
    companies: null,
  },
];

// Waiting-list fixtures for /admin/users: one account with a full name, one without.
const pendingUsers: PendingAssignmentUser[] = [
  {
    id: "00000000-0000-4000-8000-0000000000a1",
    email: "jan.kowalski@klient-alfa.local",
    fullName: "Jan Kowalski",
    createdAt: "2026-10-27T09:30:00.000Z",
  },
  {
    id: "00000000-0000-4000-8000-0000000000a2",
    email: "nowe.konto@klient-beta.local",
    fullName: null,
    createdAt: "2026-10-29T16:05:00.000Z",
  },
];
const assignmentCompanies = [
  { id: "company-alfa", name: "Klient Alfa" },
  { id: "company-beta", name: "Klient Beta" },
];
const pendingList: PendingAssignmentsResult = { status: "ok", users: pendingUsers, companies: assignmentCompanies };
const pendingEmpty: PendingAssignmentsResult = { status: "ok", users: [], companies: assignmentCompanies };
const assignmentCells: {
  title: string;
  pending: PendingAssignmentsResult;
  successMessage?: string;
  errorMessage?: string;
}[] = [
  { title: "Lista: dwa konta (z imieniem i nazwiskiem i bez)", pending: pendingList },
  { title: "Pusta lista", pending: pendingEmpty },
  { title: "Brak firm klienckich", pending: { status: "ok", users: pendingUsers, companies: [] } },
  { title: "Błąd wczytania", pending: { status: "error" } },
  { title: "Komunikat sukcesu", pending: pendingEmpty, successMessage: "Konto przypisane do firmy." },
  {
    title: "Komunikat błędu",
    pending: pendingList,
    errorMessage: "Nic nie zmieniono — konto już nie istnieje albo ma już firmę.",
  },
];
---

<Layout title="Kitchen sink UI">
  <div class="min-h-screen space-y-10 bg-background p-4 sm:p-8">
    <header class="space-y-2">
      <h1 class="text-2xl font-bold text-foreground">Kitchen sink UI</h1>
      <p class="text-sm text-muted-foreground">
        Każdy stan widoków na kontrakcie UI (strona startowa, /report-error, /my-tickets, /admin/tickets, /admin/users,
        strona 404, logowanie i zakładanie konta) na statycznych danych, bez zapytań do API. Hover i focus-visible
        sprawdź myszą i klawiszem Tab na tej stronie.
      </p>
    </header>

    <section class="space-y-4">
      <h2 class="text-xl font-bold text-foreground">Pasek użytkownika</h2>
      <p class="text-sm text-muted-foreground">
        Gość, klient (aktywne „Zgłoś błąd”, potem „Moje zgłoszenia”), serwis (bez aktywnego, potem aktywne „Zgłoszenia
        do rozwiązania”, aktywne „Użytkownicy”), konto bez roli; motyw jasny (XEMI) i wariant ciemny w opakowaniu
        class="dark".
      </p>
      <UserBar email={null} access="none" currentPath="/" />
      <UserBar email="alfa@klient-alfa.local" access="client" currentPath="/report-error" />
      <UserBar email="alfa@klient-alfa.local" access="client" currentPath="/my-tickets" />
      <UserBar email="serwis@xemi.local" access="staff" currentPath="/" />
      <UserBar email="serwis@xemi.local" access="staff" currentPath="/admin/tickets" />
      <UserBar email="serwis@xemi.local" access="staff" currentPath="/admin/users" />
      <UserBar email="oczekujacy@xemi.local" access="none" currentPath="/" />
      <div class="dark space-y-4 rounded-xl bg-background p-4">
        <UserBar email={null} access="none" currentPath="/" />
        <UserBar email="serwis@xemi.local" access="staff" currentPath="/admin/tickets" />
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-bold text-foreground">Strona startowa</h2>
      <p class="text-sm text-muted-foreground">Widok / dla każdej grupy odbiorców.</p>
      <h3 class="text-base font-bold text-foreground">Gość</h3>
      <StartPage audience="guest" />
      <h3 class="text-base font-bold text-foreground">Klient</h3>
      <StartPage audience="client" />
      <h3 class="text-base font-bold text-foreground">Serwis</h3>
      <StartPage audience="staff" />
      <h3 class="text-base font-bold text-foreground">Konto czeka na przypisanie</h3>
      <StartPage audience="waiting" />
      <h3 class="text-base font-bold text-foreground">Błąd wczytania konta</h3>
      <StartPage audience="profile-error" />
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-bold text-foreground">Strona 404</h2>
      <p class="text-sm text-muted-foreground">Karta „Nie znaleziono strony” z linkiem powrotu na stronę startową.</p>
      <NotFound />
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-bold text-foreground">Kolejka serwisu</h2>
      <p class="text-sm text-muted-foreground">
        Widok /admin/tickets: lista, pusta kolejka, błąd wczytania, komunikaty, baner „Przelicz”, link „Dalej” i filtr
        firm (wszystkie, wybrana, pusta firma, ukryty). Podgląd do bazy wiedzy aktualizuje się przy pisaniu.
      </p>
      {queueCells.map((cell, index) => (
        <>
          <h3 class="text-base font-bold text-foreground">{cell.title}</h3>
          <Card className="gap-0 p-6 sm:p-8">
            <StaffTicketQueue
              queue={cell.queue}
              successMessage={cell.successMessage ?? null}
              errorMessage={cell.errorMessage ?? null}
              missingEmbeddings={cell.missingEmbeddings ?? null}
              nextHref={cell.nextHref ?? null}
              companies={cell.companies ?? null}
              selectedCompanyId={cell.selectedCompanyId ?? null}
              filterId={`company-filter-${String(index)}`}
            />
          </Card>
        </>
      ))}
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-bold text-foreground">Konta do przypisania</h2>
      <p class="text-sm text-muted-foreground">
        Widok /admin/users: lista kont z datą założenia, pusta lista, brak firm klienckich, błąd wczytania i komunikaty.
      </p>
      {assignmentCells.map((cell) => (
        <>
          <h3 class="text-base font-bold text-foreground">{cell.title}</h3>
          <Card className="gap-0 p-6 sm:p-8">
            <StaffUserAssignment
              pending={cell.pending}
              successMessage={cell.successMessage ?? null}
              errorMessage={cell.errorMessage ?? null}
            />
          </Card>
        </>
      ))}
    </section>

    <AuthKitchenSink client:only="react" />

    <section class="space-y-4">
      <h2 class="text-xl font-bold text-foreground">Potwierdzenie e-maila</h2>
      <p class="text-sm text-muted-foreground">
        Widok /auth/confirm-email: konto potwierdzone automatycznie (dev) i link aktywacyjny wysłany e-mailem.
      </p>
      <h3 class="text-base font-bold text-foreground">Konto założone (dev)</h3>
      <ConfirmEmailNotice autoConfirmed />
      <h3 class="text-base font-bold text-foreground">Sprawdź skrzynkę e-mail</h3>
      <ConfirmEmailNotice autoConfirmed={false} />
    </section>

    <KitchenSink client:only="react" />
  </div>
</Layout>
