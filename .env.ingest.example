# Ustawienia skryptu wgrywającego dokumentację ERP (npm run ingest).
# Skopiuj ten plik jako .env.ingest (w tym samym folderze) i uzupełnij wartości po znaku "=".
# Każda wartość w osobnej linii, bez spacji wokół "=" i bez cudzysłowów.
#
# Plik .env.ingest zawiera klucze dostępowe: nie wysyłaj go nikomu, nie wklejaj na czat,
# do e-maila ani do zgłoszenia. Git go pomija, więc nie trafi do repozytorium.
# Hasła NIE wpisuj tutaj — skrypt zawsze pyta o nie przy uruchomieniu.
#
# Instrukcja krok po kroku: docs/wgrywanie-dokumentacji-erp.md

# Adres bazy HelpDesku, np. https://abcdefghijklmnop.supabase.co (otrzymasz od administratora).
SUPABASE_URL=

# Klucz publiczny bazy (anon / sb_publishable_…) — ten sam, którego używa aplikacja HelpDesk.
# Nigdy klucz tajny (service_role / sb_secret_…): skrypt go odrzuci.
SUPABASE_KEY=

# Klucz API OpenAI (zaczyna się od sk-), otrzymasz od administratora.
# Potrzebny tylko do wgrywania dokumentów; --lista i --usun działają bez niego.
OPENAI_API_KEY=

# (Opcjonalnie) e-mail Twojego konta serwisanta w HelpDesku. Puste = skrypt zapyta o e-mail.
HELPDESK_EMAIL=
